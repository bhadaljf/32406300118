@startuml
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

actor 申请人 as User
participant "预约控制器\nBookingController" as Controller
participant "应用服务\nBookingService" as Service
participant "身份接口\n<<interface>>\nIdentityInterface" as Identity
participant "仓储接口\n<<interface>>\nReservationRepository" as Repo
database "关系型数据库\n(唯一约束)" as DB

User -> Controller : 1. 提交预约申请 (token, 预约数据)
activate Controller
Controller -> Service : 2. createReservation(command)
activate Service

' === 外部系统隔离 ===
Service -> Identity : 3. verifyToken(token)
activate Identity
Identity --> Service : 4. 返回用户信息/校验通过
deactivate Identity

' === 应用层编排校验 ===
Service -> Repo : 5. findByLabAndPeriod(labId, periodId)
activate Repo
Repo --> Service : 6. 返回已有预约列表
deactivate Repo

alt 时段已被占用 (应用层查冲突)
    Service --> Controller : 7a. 抛出业务异常：时段冲突
    Controller --> User : 8a. 返回友好提示“该时段已被预约”
else 时段可用
    Service -> Service : 7b. 构造预约实体
    Service -> Repo : 8b. save(reservation)
    activate Repo
    Repo -> DB : 9b. INSERT INTO reservation...
    activate DB

    alt 数据库唯一约束触发 (并发穿透兜底)
        DB --> Repo : 10b. 抛出 DuplicateKey 异常
        Repo --> Service : 11b. 捕获并转为仓储异常
        Service --> Controller : 12b. 抛出业务异常：并发冲突
        Controller --> User : 13b. 返回友好提示“该时段刚好被他人抢约，请重新选择”
    else 写入成功
        DB --> Repo : 10c. 返回影响行数 (1)
        Repo --> Service : 11c. 返回持久化实体
        Service --> Controller : 12c. 返回成功结果
        Controller --> User : 13c. 提交成功，返回预约编号
    end
    deactivate DB
    deactivate Repo
end
deactivate Service
deactivate Controller
@enduml
