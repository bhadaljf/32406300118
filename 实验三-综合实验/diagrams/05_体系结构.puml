@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 12
skinparam componentStyle rectangle
top to bottom direction

package "接入层" {
  [单页应用\n预约 / 审核 / 管理]
  [接口网关\n鉴权 · 限流 · 日志]
}

package "应用模块" {
  [用户与权限模块\n登录 · 角色 · 权限]
  [实验室资源模块\n实验室 · 时段]
  [预约业务模块\n申请 · 审核 · 签到]
}

package "领域与仓储" {
  [领域对象\n用户 / 实验室 / 时段 / 申请 / 记录]
  [仓储实现\n关系数据库映射]
}

package "外部与批处理" {
  [统一身份服务适配器]
  [归档与过期任务]
}

[单页应用\n预约 / 审核 / 管理] --> [接口网关\n鉴权 · 限流 · 日志]
[接口网关\n鉴权 · 限流 · 日志] --> [用户与权限模块\n登录 · 角色 · 权限]
[接口网关\n鉴权 · 限流 · 日志] --> [实验室资源模块\n实验室 · 时段]
[接口网关\n鉴权 · 限流 · 日志] --> [预约业务模块\n申请 · 审核 · 签到]
[用户与权限模块\n登录 · 角色 · 权限] --> [统一身份服务适配器]
[实验室资源模块\n实验室 · 时段] --> [领域对象\n用户 / 实验室 / 时段 / 申请 / 记录]
[预约业务模块\n申请 · 审核 · 签到] --> [领域对象\n用户 / 实验室 / 时段 / 申请 / 记录]
[预约业务模块\n申请 · 审核 · 签到] --> [仓储实现\n关系数据库映射]
[归档与过期任务] --> [仓储实现\n关系数据库映射]
@enduml
