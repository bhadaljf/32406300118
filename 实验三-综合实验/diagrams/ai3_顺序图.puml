@startuml
skinparam sequenceMessageAlign center
autonumber

actor 学生 as student
participant "网关(API Gateway)" as gateway
participant "预约控制器\nReservationController" as controller
participant "权限服务\nIAuthService" as authSvc
participant "实验室服务\nILabService" as labSvc
participant "预约服务\nIReservationService" as resvSvc
participant "预约仓储\nIReservationRepository" as resvRepo

student -> gateway : 1. 提交预约申请(请求体包含LabId, TimeSlot)
activate gateway
gateway -> authSvc : 2. 校验身份权限(Token)
activate authSvc
authSvc --> gateway : 3. 校验通过
deactivate authSvc
gateway -> controller : 4. 路由转发请求
deactivate gateway
activate controller

controller -> resvSvc : 5. createReservation(request)
activate resvSvc

resvSvc -> labSvc : 6. 查询实验室容量与开放状态(labId)
activate labSvc
labSvc --> resvSvc : 7. 返回状态(可用/容量足够)
deactivate labSvc

resvSvc -> resvSvc : 8. 冲突检测(checkConflict)

alt 冲突检测失败(如时间冲突/容量不足)
    resvSvc --> controller : 9a. 抛出异常/返回失败结果
    controller --> student : 10a. 返回 HTTP 409 (Conflict) + 具体原因
else 校验成功
    resvSvc -> resvRepo : 9b. save(reservation)
    activate resvRepo
    resvRepo --> resvSvc : 10b. 保存成功
    deactivate resvRepo
    resvSvc --> controller : 11b. 返回待审核状态(PENDING)
    controller --> student : 12b. 返回 HTTP 200 + 待审核通知
end

deactivate resvSvc
deactivate controller
@enduml
